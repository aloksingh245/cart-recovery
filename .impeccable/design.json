  "narrative": {
    "northStar": "The Recovery Workbench",
    "overview": "A restrained off-white and pine operations surface makes decisions and their evidence easy to read. Familiar system typography, compact rows, and steady alignment support repeated inspection rather than visual spectacle.\n\nWhite containers separate tasks from the warm work surface. Text labels accompany semantic color, and visible focus states keep contextual actions accessible. This system is extracted from the delivered CSS; the earlier provisional notes are reconciled here with its actual values.",
    "keyCharacteristics": [
      "Warm work surface with white task containers and pine actions.",
      "Compact operational typography with tabular numbers.",
      "Flat bordered surfaces and shallow rounded controls.",
      "Responsive navigation and locally scrolling data tables."
    ],
    "rules": [
      {
        "name": "The Labeled State Rule",
        "body": "Status meaning is carried by visible text alongside semantic color.",
        "section": "colors"
      },
      {
        "name": "The Numeric Alignment Rule",
        "body": "Use tabular numerals for operational values and right-align comparable numeric columns.",
        "section": "typography"
      },
      {
        "name": "The Work-Surface Rule",
        "body": "Keep data containers flat and use the floating-toast shadow only for transient feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use text with semantic status colors.",
      "Do preserve tabular numeric alignment in operational data.",
      "Do keep tables inside their own scrolling regions on narrow screens.",
      "Do retain the shared visible focus outline and reduced-motion behavior.",
      "Do use the existing system font stack without external font requests."
    ],
    "donts": [
      "Don't add shadows to task panels or data tables.",
      "Don't substitute decorative cards for compact rows of comparable data.",
      "Don't use color alone to distinguish errors, warnings, or selection."
    ]
  }
